{
  "name": "zellij-claude-pair",
  "image": "mcr.microsoft.com/devcontainers/base:3.0.13-ubuntu24.04@sha256:48be4adec1c1ecbe030064700aef85382f5205786a8f82937fc44a7473717eae",
  "features": {
    "ghcr.io/devcontainers-extra/features/apt-packages:1": {
      "packages": "libssl-dev,pkg-config"
    },
    "ghcr.io/devcontainers-extra/features/mise:1": {},
    "ghcr.io/devcontainers/features/rust:1": {
      "components": "none"
    },
    "ghcr.io/anthropics/devcontainer-features/claude-code:1": {}
  },
  "mounts": [
    "source=claude-code-config-${devcontainerId},target=/home/vscode/.claude,type=volume"
  ],
  "containerEnv": {
    "CLAUDE_CONFIG_DIR": "/home/vscode/.claude",
    "MISE_TRUSTED_CONFIG_PATHS": "${containerWorkspaceFolder}"
  },
  "remoteUser": "vscode",
  "remoteEnv": {
    "CLAUDE_CODE_OAUTH_TOKEN": "${localEnv:CLAUDE_CODE_OAUTH_TOKEN}",
    "PATH": "/home/vscode/.local/share/mise/shims:${containerEnv:PATH}"
  },
  "postCreateCommand": "sudo chown \"$(id -un):\" \"$CLAUDE_CONFIG_DIR\" && rustup toolchain install && mise install"
}
